# Moniple Agent Configuration
# Compatible with both Prometheus and Victoria Metrics

# Required: Prometheus/VictoriaMetrics API URL
# Examples:
#   Prometheus:        http://prometheus:9090/api/v1
#   Victoria Metrics:  http://vmselect:8481/select/0/prometheus/api/v1
PROMETHEUS_API_URL=http://prometheus:9090/api/v1

# Optional: Basic Auth credentials (leave empty if not needed)
PROMETHEUS_API_USER=
PROMETHEUS_API_PASSWORD=

# Optional: Threshold for critical alerts (default: 80%)
DEFAULT_THRESHOLD=80

# Optional: Server port (default: 3000)
PORT=3000
