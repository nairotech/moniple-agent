# Moniple Agent Configuration
# Compatible with both Prometheus and Victoria Metrics

# Required: Prometheus/VictoriaMetrics API URL
# Examples:
#   Prometheus:        http://prometheus:9090/api/v1
#   Victoria Metrics:  http://vmselect:8481/select/0/prometheus/api/v1
PROMETHEUS_API_URL=http://prometheus:9090/api/v1

# Optional: Basic Auth credentials (leave empty if not needed)
PROMETHEUS_API_USER=
PROMETHEUS_API_PASSWORD=

# Optional: Threshold for critical alerts (default: 80%)
DEFAULT_THRESHOLD=80

# Optional: Server port (default: 3000)
PORT=3000

# Moniple Server Configuration (for central metrics collection)
# Get your API key from Moniple App when creating a cluster
MONIPLE_SERVER_URL=https://api.moniple.com
MONIPLE_API_KEY=

# Push interval in seconds (default: 60)
PUSH_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# Security hardening (all optional)
# -----------------------------------------------------------------------------

# Remediation execution mode for Moniple Doctor approved actions.
#   full = execute all allowed & validated actions (default; current behavior)
#   safe = block destructive actions (delete_pod, delete_job, scale_deployment,
#          cordon_node, rollback_deployment); allow the rest
#   off  = reject every remediation action
# Note: actions targeting kube-system / kube-public / kube-node-lease are
# ALWAYS rejected regardless of this setting.
DOCTOR_REMEDIATION_MODE=full

# Allow the LLM (Doctor) base_url to point at a private/cluster-internal address
# (10.x, 192.168.x, 172.16-31.x, *.svc, *.cluster.local, *.internal).
# Cloud metadata + loopback are ALWAYS blocked and cannot be re-enabled.
# Default false (only public LLM endpoints allowed).
DOCTOR_ALLOW_PRIVATE_LLM_ENDPOINT=false

# Allow unauthenticated access to /metrics/* when MONIPLE_API_KEY is NOT set.
# Default false (fail-closed: no key configured -> /metrics returns 401).
# /health is always public regardless of this setting (k8s probes).
ALLOW_UNAUTHENTICATED_METRICS=false

# Restrict CORS to a specific browser origin (e.g. https://dashboard.example.com).
# Default: CORS disabled (these are machine endpoints, not a browser app).
# AGENT_CORS_ORIGIN=
